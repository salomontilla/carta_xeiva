---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Platos from "../components/Platos.jsx";
import Footer from "../components/Footer.jsx";
import Carousel from "../components/Carousel.jsx";
import Location from "../components/Location.astro";
import img1 from "../assets/decoracion_3.webp"
import img2 from "../assets/decoracion_4.webp"
import img3 from "../assets/xeiva_paisaje_1.webp"
import { getImage } from "astro:assets";

const slides = [
  {
    image: await getImage({
      src: img1,
      widths: [360, 480, 768, 1024],
    }),
    text: "Salon de eventos",
  },
  {
    image: await getImage({
      src: img2,
      widths: [360, 480, 768, 1024],
    }),
    text: "Espacios acogedores",
  },
  {
    image: await getImage({
      src: img3,
      widths: [360, 480, 768, 1024],
    }),
    text: "Zonas verdes",
  },
];
---

<Layout>
  <Hero />
  <Platos client:idle />
  <Carousel slides={slides} client:idle />
  <Location />
  <Footer client:idle />
</Layout>
