---
import { Icon } from "@iconify/react";
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      {/* Restaurant Info */}
      <div class="footer-section">
        <h3 class="footer-title">Xeiva</h3>
        <p class="footer-tagline">Sabor casero y tradición familiar</p>
      </div>

      {/* Hours */}
      <div class="footer-section">
        <h4 class="footer-heading">Horarios</h4>
        <ul class="footer-list">
          <li>Lunes - Viernes: 11:00 AM - 9:00 PM</li>
          <li>Sábados: 11:00 AM - 10:00 PM</li>
          <li>Domingos: 11:00 AM - 8:00 PM</li>
        </ul>
      </div>

      {/* Contact */}
      <div class="footer-section">
        <h4 class="footer-heading">Contacto</h4>
        <ul class="footer-list">
          <li>📍 Huila, Colombia</li>
          <li>📞 +57 300 123 4567</li>
          <li>✉️ info@xeiva.com</li>
        </ul>
      </div>

      {/* Social Media */}
      <div class="footer-section">
        <h4 class="footer-heading">Síguenos</h4>
        <div class="social-links">
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="Instagram"
          >
            <Icon icon="mdi:instagram" width="24" height="24" />
          </a>
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="Facebook"
          >
            <Icon icon="mdi:facebook" width="24" height="24" />
          </a>
          <a
            href="https://wa.me/573001234567"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="WhatsApp"
          >
            <Icon icon="mdi:whatsapp" width="24" height="24" />
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        &copy; {new Date().getFullYear()} Restaurant Xeiva. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(
      135deg,
      var(--color-earth-dark) 0%,
      var(--color-earth) 100%
    );
    padding: var(--spacing-3xl) 0 var(--spacing-xl);
    margin-top: var(--spacing-3xl);
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-xl);
  }

  .footer-section {
    color: var(--color-neutral-700);
  }

  .footer-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    color: var(--color-primary-red);
    margin-bottom: var(--spacing-xs);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--color-neutral-600);
    font-style: italic;
  }

  .footer-heading {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-neutral-800);
    margin-bottom: var(--spacing-sm);
  }

  .footer-list {
    list-style: none;
    padding: 0;
  }

  .footer-list li {
    margin-bottom: var(--spacing-xs);
    font-size: 0.875rem;
    color: var(--color-neutral-600);
  }

  .social-links {
    display: flex;
    gap: var(--spacing-sm);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: white;
    border-radius: 50%;
    color: var(--color-primary-red);
    transition: all var(--transition-fast);
    box-shadow: var(--shadow-sm);
  }

  .social-link:hover {
    background: var(--color-primary-red);
    color: white;
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .footer-bottom {
    text-align: center;
    padding-top: var(--spacing-xl);
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .footer-bottom p {
    font-size: 0.875rem;
    color: var(--color-neutral-600);
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
      text-align: center;
    }

    .social-links {
      justify-content: center;
    }
  }
</style>
