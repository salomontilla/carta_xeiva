---
import Reveal from "./Reveal";
---

<section
  id="ubicacion"
  class="relative py-20 bg-red-900 text-white overflow-hidden"
>
  <div
    class="relative z-10 max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center"
  >
    {/* Text Content */}
    <div class="text-center md:text-left space-y-8">
      <Reveal client:load>
        <h2 class="text-4xl md:text-5xl font-semibold tracking-tight">
          ¿Dónde estamos
          <span class="block text-red-200/90 font-light mt-2">ubicados?</span>
        </h2>

        <div
          class="h-[2px] w-24 bg-gradient-to-r from-red-600 to-transparent mx-auto md:mx-0 my-6"
        >
        </div>

        <p class="text-lg text-white/80 font-light leading-relaxed">
          Ven a disfrutar! Te esperamos con los brazos abiertos y la mesa
          servida.
        </p>

        <div class="mt-6 text-base text-white/80 font-light">
          <p>📍 Guayabal, Huila. Km 2 Via Florencia</p>
          <p>🕒 Domingos y Lunes festivos</p>
        </div>

        <div class="pt-6">
          <a
            href="https://maps.app.goo.gl/TCjgmx137kYTXrQn7"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-8 py-3 rounded-xl border border-gray-100 text-gray-100 font-medium
         hover:opacity-80 transition-all
         shadow-[0_4px_20px_rgba(220,38,38,0.15)]
         hover:shadow-[0_4px_25px_rgba(220,38,38,0.35)]
         hover:-translate-y-0.5"
          >
            Ver en Google Maps
          </a>
          <a
            href="https://wa.me/+573118625234?text=Hola! Quiero realizar una reserva: "
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block m-2 px-8 py-3 rounded-xl border border-gray-100 text-gray-100 font-medium
         hover:opacity-80 transition-all
         shadow-[0_4px_20px_rgba(220,38,38,0.15)]
         hover:shadow-[0_4px_25px_rgba(220,38,38,0.35)]
         hover:-translate-y-0.5"
          >
            Contáctanos
          </a>
        </div>
      </Reveal>
    </div>

    {/* Map Visual */}
    <div
      class="relative h-[400px] w-full rounded-2xl overflow-hidden border border-white/10 shadow-2xl"
    >
      <Reveal client:load className="h-full">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15950.484606525279!2d-75.8153941302246!3d1.9015716999999972!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e2503a520ee8c67%3A0xdd519df1e40cece9!2sRestaurante%20Xeiva!5e0!3m2!1ses!2sco!4v1765669691375!5m2!1ses!2sco"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="md:grayscale md:opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-700"
        ></iframe>
        {/* Overlay text for interacting */}
        <div
          class="absolute inset-0 pointer-events-none bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-60"
        >
        </div>
      </Reveal>
    </div>
  </div>
</section>
