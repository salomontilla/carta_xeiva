---
import { Image } from 'astro:assets';
import myImage from "../assets/xeiva_paisaje_3.webp";
---

<section class="relative min-h-screen pt-[80px] flex items-center overflow-hidden">
  
  <!-- Background Image -->
  <Image 
    src={myImage} 
    alt="Paisaje Xeiva Restaurante"
    class="absolute inset-0 w-full h-full object-cover"
  />

  <!-- Warm rustic overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-red-900/50 via-black/40 to-black/70"></div>

  <!-- Rustic red glow accents -->
  <div class="absolute top-20 left-16 w-40 h-40 bg-red-700/20 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 right-20 w-52 h-52 bg-red-900/25 rounded-full blur-2xl"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center text-white drop-shadow-xl">
    
    <h1 class="text-5xl md:text-7xl font-semibold tracking-tight">
      Xeiva  
      <span class="block font-light md:text-5xl text-4xl text-red-200/90 tracking-wide">
        Restaurante
      </span>
    </h1>

    <p class="mt-6 text-lg md:text-2xl text-white/85 leading-relaxed max-w-2xl mx-auto font-light">
      Bienvenido a Xeiva Restaurante, conoce nuestra carta y dejate sorprender por los sabores de nuestras tierras.
    </p>

    {/* Rustic underline */}
    <div class="mt-6 h-[3px] w-32 mx-auto bg-gradient-to-r from-red-600 via-red-400 to-red-600 rounded-full shadow-[0_2px_8px_rgba(255,0,0,0.35)]"></div>

    {/* Buttons */}
    <div class="mt-10 flex justify-center gap-5">
      <a
        href="#menu"
        class="px-7 py-3 rounded-xl bg-red-600 text-white font-medium text-sm tracking-wide 
               shadow-lg shadow-red-900/30 hover:bg-red-500 transition-all"
      >
        Ver Menú
      </a>

      <a
        href="#reservas"
        class="px-7 py-3 rounded-xl border border-red-300 text-red-200 font-medium text-sm 
               hover:bg-red-200/10 backdrop-blur-md transition-all"
      >
        Reservar
      </a>
    </div>

  </div>

</section>
